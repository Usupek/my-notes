POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://notes:change-me@db:5432/notes?sslmode=disable
ADMIN_PASSWORD_HASH='$2a$12$replace_with_a_bcrypt_hash'
SESSION_TTL=24h
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
ALLOWED_ORIGIN=http://localhost:8080
# Public base URL used for absolute links in /feed.xml (falls back to the request host)
SITE_URL=http://localhost:8080
# Set to false to turn off the RSS feed, /subscribe page and footer button (rebuild the web image after changing)
RSS_ENABLED=true
STORAGE_DIR=/app/data/notes
MAX_MARKDOWN_BYTES=1048576
MAX_IMAGE_BYTES=5242880
NEXT_PUBLIC_API_URL=
